<style type="text/css">
  body,
  html, 
  .body {
    background: #f3f3f3 !important;
  }

  .header {
    background: #f3f3f3;
  }

  .white-box {
    background: #ffffff;
  }

  .fine-print {
    color: #bcbcbc !important;
  }
</style>
<!-- move the above styles into your custom stylesheet -->

<div style="height: 16px;"></div>

<div class="grid-container">

  <div class="grid-x header">
    <div class="cell">
      <div style="height: 16px;"></div>
      
      <h3 class="text-center" style="font-weight: normal; color: #222222; margin-bottom: 0;">Pirate Retirement Services</h3>
      
      <div style="height: 16px;"></div>
    </div>
  </div>
  <div class="grid-x white-box" style="background: #ffffff;">
    <div class="cell">

      <div style="height: 32px;"></div>

      <h1 class="text-center" style="font-weight: normal; margin-top: 10px; color: #000000;">Forgot Your Password?</h1>
      
      <div style="height: 16px;"></div>

      <p class="text-center" style="font-size: 16px; color: #000000;">It happens. Click the link below to reset your password.</p>
      
      <div style="height: 16px;"></div>

      <p class="text-center">
        <a class="button large expanded" href="<%= "#{message['redirect-url']}?reset_password_token=#{@token}" %>" style="background-color: #2ba6cb; color: #ffffff; border: none; padding: 10px 20px; text-decoration: none;">Reset Password</a>
      </p>

      <div style="height: 16px;"></div>

      <hr style="border-top: 1px solid #cccccc;" />

      <p class="fine-print" style="color: #bcbcbc; font-size: 13px; margin-bottom: 5px;">
        <small>Hello <%= @resource.email %>! If you didn't request this, please ignore this email. Your password won't change until you access the link above and create a new one.</small>
      </p>

      <p class="fine-print" style="color: #bcbcbc; font-size: 13px; margin-top: 0;">
        <small>You're getting this email because you've signed up for email updates. If you want to opt-out of future emails, <a href="#" style="color: #2fa4e7; text-decoration: none;">unsubscribe here</a>.</small>
      </p>
      
      <div style="height: 32px;"></div>
    </div>
  </div>

  <div style="height: 16px;"></div>
</div>
